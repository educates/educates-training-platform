# A copier rule gated by copyAuthorization with no importer, until fix creates one.
[applied]
secretcopier/kit-secrets-manager-awaiting-authorization  ready   = False
secretcopier/kit-secrets-manager-awaiting-authorization  reason  = AwaitingAuthorization
secretcopier/kit-secrets-manager-awaiting-authorization  insync  = 0/1
secretcopier/kit-secrets-manager-awaiting-authorization  message ~ No SecretImporter accepts the copy in namespaces kit-secrets-manager-target-a
kit-secrets-manager-target-a/secret/gated  absent
event secretcopier/kit-secrets-manager-awaiting-authorization  Warning NotReady

[fixed]
secretcopier/kit-secrets-manager-awaiting-authorization  ready   = True
secretcopier/kit-secrets-manager-awaiting-authorization  reason  = InSync
secretcopier/kit-secrets-manager-awaiting-authorization  insync  = 1/1
kit-secrets-manager-target-a/secretimporter/gated  ready   = True
kit-secrets-manager-target-a/secretimporter/gated  reason  = Imported
kit-secrets-manager-target-a/secretimporter/gated  {.status.boundTo.kind}  = SecretCopier
kit-secrets-manager-target-a/secretimporter/gated  {.status.boundTo.name}  = kit-secrets-manager-awaiting-authorization
kit-secrets-manager-target-a/secret/gated  {{index .data "api-key" | base64decode}}  = gated-value
event kit-secrets-manager-target-a/secretimporter/gated  Normal Imported
event secretcopier/kit-secrets-manager-awaiting-authorization  Normal Recovered
