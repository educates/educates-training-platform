{
  "id": "125-session-affinity-outside-tenant",
  "step": "beta-allocated",
  "description": "user-1 requests lab-beta through tenant-names, whose only portal, portal-b, does not offer it: the Python service returns user-1's session on portal-a, outside the tenant's reach.",
  "source": "captured",
  "actions": [],
  "request": {
    "method": "POST",
    "path": "/api/v1/workshops",
    "headers": {
      "Authorization": "Bearer <token:tenant-client>",
      "Content-Type": "application/json"
    },
    "body": "{\"tenantName\": \"tenant-names\", \"workshopName\": \"lab-beta\", \"clientUserId\": \"user-1\", \"clientActionId\": \"action-1\", \"clientIndexUrl\": \"https://sites.example.test/index\", \"userEmailAddress\": \"user-1@example.test\", \"userFirstName\": \"User\", \"userLastName\": \"One\", \"workshopParams\": [{\"name\": \"greeting\", \"value\": \"hello\"}]}"
  },
  "response": {
    "status": 200,
    "contentType": "application/json; charset=utf-8",
    "bodyFormat": "json",
    "body": {
      "clusterName": "cluster-a",
      "portalName": "portal-a",
      "environmentName": "portal-a-w02",
      "sessionName": "<session:beta-user-1>",
      "clientUserId": "user-1",
      "sessionActivationUrl": "https://portal-a-ui.lsg-golden-a.educates.test/workshops/session/<session:beta-user-1>/activate/?token=<activation-token>&index_url=https%3A%2F%2Fsites.example.test%2Findex",
      "tenantName": "tenant-names"
    }
  },
  "change": {
    "summary": "A returning user is matched only against sessions on portals the requesting tenant can reach. tenant-names reaches no portal that offers lab-beta, so the request finds no workshop.",
    "spec": "Session affinity; user story 27",
    "expected": {
      "status": 503,
      "contentType": "text/plain; charset=utf-8",
      "bodyFormat": "text",
      "body": "Workshop not available"
    }
  }
}
